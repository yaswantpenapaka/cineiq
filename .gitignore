# NOTE: data/movielens/ratings.csv and models/svd_model.pkl are tracked by
# DVC, not Git — DVC auto-appends precise ignore entries for them when you
# run `dvc add`. Do NOT blanket-ignore data/ or models/ here, or Git will
# also hide the .dvc pointer files DVC needs to commit.

# Raw / third-party datasets not tracked by DVC (too large, re-downloadable)
# NOTE: data/movielens/ratings.csv is intentionally NOT listed here — it's
# tracked by DVC instead.
data/tmdb/
data/imdb/
data/movielens/movies.csv
data/movielens/links.csv
data/movielens/tags.csv
data/movielens/genome-scores.csv
data/movielens/genome-tags.csv
data/movielens/README.txt
datasets/

# Runtime data generated by the app, not a versioned artifact
feedback/*.csv

*.parquet
*.zip
*.pt
*.pth
*.joblib

# Python cache
__pycache__/
*.py[cod]

# MLflow local fallback store (only used when no MLFLOW_TRACKING_URI is set)
mlruns/
